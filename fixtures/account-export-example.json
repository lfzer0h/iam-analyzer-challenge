    "design_intent": "Each role was crafted to expose a specific detection ambiguity. Some roles look dangerous but are controlled; others look clean but hide escalation chains.",
    "ambiguity_scenarios": [
      {"role": "kms-rotation-lambda",      "looks_like": "CRITICAL — kms:* on payments aliases",    "really_is": "MEDIUM — ProdNetworkBoundary caps effective permissions"},
      {"role": "dev-sandbox-tester",       "looks_like": "HIGH — secretsmanager:* wildcard",         "really_is": "INFORMATIONAL — resources scoped to dev/* namespace only"},
      {"role": "legacy-cron",              "looks_like": "safe — minimal S3 permissions",            "really_is": "CRITICAL — Principal:* in trust policy (confused-deputy risk)"},
      {"role": "ci-deployer",              "looks_like": "safe — deploy automation",                  "really_is": "CRITICAL — hidden PassRole(*) + lambda:CreateFunction escalation chain"},
      {"role": "settlement-batch",         "looks_like": "risky — iam:PassRole present",             "really_is": "clean — PassRole scoped to specific role ARN, not a wildcard"},
      {"role": "backup-vault-role",        "looks_like": "risky — backup:* on Resource:*",           "really_is": "clean — backup:* is not a PCI-sensitive action, no finding fires"},
      {"role": "checkout-router",          "looks_like": "CRITICAL — secretsmanager access",         "really_is": "MEDIUM — aws:SourceVpc condition mitigates to network-scoped access"},
      {"role": "partner-settlement-reader","looks_like": "risky — cross-account trust",              "really_is": "clean — trusted account + sts:ExternalId condition present"}
    ],
    "campaign_triggers": {
      "CAMP-001": "Managed policy LegacyBroadSecretsAccess attached to data-warehouse-sync, reporting-etl, fraud-scoring-batch",
      "CAMP-002": "Identical inline policy SharedLaxSecretsPolicy in merchant-onboarding and merchant-onboarding-service-v2 (fingerprint-based grouping, not name-based)"
    }
